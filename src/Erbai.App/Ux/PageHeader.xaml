<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Erbai.App.Ux.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 统一页头（2026-10 UI 美化轮）：品牌橙图标章 + 页标题 + 副标题。
         各页手写的"标题 StackPanel"统一收敛到此组件，页首获得一致的视觉锚点。 -->
    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,2">
        <Border x:Name="IconChip" Width="46" Height="46" CornerRadius="12"
                Background="{ThemeResource BrandChipBackgroundBrush}"
                VerticalAlignment="Center">
            <FontIcon x:Name="GlyphIcon" FontSize="20" Foreground="{ThemeResource BrandAccentBrush}" />
        </Border>
        <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</UserControl>
