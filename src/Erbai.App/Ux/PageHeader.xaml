<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Erbai.App.Ux.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="5" Margin="0,0,0,8">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextStyle}"
                   FontSize="13" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
