<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Erbai.App.Views.DanmakuLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Erbai.App.Views">
    <Grid Padding="24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="日志" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="CountText" Text="0 条" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Bottom" />
            <TextBlock Text="直播活动事件与系统日志混合查看；清空在右下工具栏" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Bottom" />
        </StackPanel>

        <!-- 工具栏：搜索 + 类型多选（评审第一轮 #7：与"全部"自相矛盾的模型改为全选动作） -->
        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="SearchBox" Width="200" PlaceholderText="搜索内容…" TextChanged="OnSearchChanged" VerticalAlignment="Center" />
                <TextBlock Text="类型（多选）：" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                <ToggleButton x:Name="FilterDanmakuBtn" Content="弹幕" Tag="danmaku" IsChecked="True" Click="OnFilterToggled" />
                <ToggleButton x:Name="FilterGiftBtn" Content="礼物" Tag="gift" IsChecked="True" Click="OnFilterToggled" />
                <ToggleButton x:Name="FilterFollowBtn" Content="关注" Tag="follow" IsChecked="True" Click="OnFilterToggled" />
                <ToggleButton x:Name="FilterLikeBtn" Content="点赞" Tag="like" IsChecked="True" Click="OnFilterToggled" />
                <ToggleButton x:Name="FilterToolBtn" Content="工具" Tag="tool" IsChecked="True" Click="OnFilterToggled" />
                <ToggleButton x:Name="FilterOtherBtn" Content="其他" Tag="other" IsChecked="True" Click="OnFilterToggled" />
                <Button Content="全选" Style="{StaticResource InlineActionButtonStyle}" Click="OnSelectAll" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="来源（单选）：" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                <ToggleButton x:Name="SourceAllBtn" Content="全部" Tag="all" IsChecked="True" Click="OnSourceSingleSelect" />
                <ToggleButton x:Name="SourceBiliBtn" Content="B站" Tag="bilibili" IsChecked="False" Click="OnSourceSingleSelect" />
                <ToggleButton x:Name="SourceDouyinBtn" Content="抖音" Tag="douyin" IsChecked="False" Click="OnSourceSingleSelect" />
                <ToggleButton x:Name="SourceSystemBtn" Content="系统" Tag="system" IsChecked="False" Click="OnSourceSingleSelect" />
                <ToggleSwitch x:Name="AutoScrollToggle" Header="自动滚动" OffContent="" OnContent="" IsOn="True" VerticalAlignment="Center" />
                <Button Content="打开日志目录" Style="{StaticResource InlineActionButtonStyle}" Click="OnOpenLogFolder" />
                <Button x:Name="ClearButton" Content="清空" Style="{StaticResource InlineActionButtonStyle}" Click="OnClear" />
            </StackPanel>
        </StackPanel>

        <!-- 表头 -->
        <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="3" Text="事件 / 内容" Style="{StaticResource CaptionTextStyle}" />
            </Grid>
        </Border>

        <!-- 结构化日志列表（正文等宽字体） -->
        <ListView Grid.Row="4" x:Name="LogList" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:DanmakuLogLine">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Time}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind TypeText}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SourceText}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Detail}" FontSize="12" FontFamily="Consolas"
                                   Foreground="{x:Bind Color}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>