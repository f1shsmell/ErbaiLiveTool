<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Erbai.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ux="using:Erbai.App.Ux"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 2026-10 布局样式轮：手写 140/* 标签网格（12+ 处重复）整体迁移到
         CommunityToolkit SettingsCard（Windows 11 设置观感：左标题/描述、右控件、
         悬停反馈），命名元素与事件全部原样保留（代码层零改动）。
         小节标题带品牌色图标；卡片组 4px 间距成组。 -->
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="6" MaxWidth="760" HorizontalAlignment="Left">

            <ux:PageHeader Icon="Setting" Title="设置" Margin="0,0,0,8"
                           Subtitle="平台、播放器、B站账号与点歌规则；保存后立即生效" />

            <!-- 常规 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="常规" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="关闭时最小化到托盘"
                             Description="点击关闭按钮后程序在后台继续运行（弹幕监听不中断）；从系统托盘图标恢复或退出">
                <ToggleSwitch x:Name="MinimizeToTrayToggle" OffContent="" OnContent="" />
            </tk:SettingsCard>

            <!-- 音乐播放器 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="音乐播放器" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="播放器" Description="未安装的平台灰显；连接器由应用自动安装维护">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- 选项在代码里按"是否已安装"动态生成：未安装的平台灰显（决策 D-D） -->
                    <ComboBox x:Name="PlayerKeyCombo" Width="220" SelectionChanged="OnPlayerKeyChanged"
                              PlaceholderText="选择播放器" />
                    <TextBlock x:Name="PlayerStatusText" Text="-" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="FoliaTokenCard" Visibility="Collapsed"
                             Header="Folia Token" Description="bilincm.cn 的 Folia 访问 token">
                <TextBox x:Name="FoliaTokenBox" Width="280" HorizontalAlignment="Right"
                         PlaceholderText="Folia 访问 token" />
            </tk:SettingsCard>
            <StackPanel x:Name="PlayerInstallHintActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" Margin="4,2,0,2">
                <TextBlock x:Name="PlayerInstallHintText" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Content="前往插件页安装" Click="OnGoToPluginsForPlayer" Padding="10,2" FontSize="11" />
            </StackPanel>

            <!-- B站账号 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="B站账号" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="账号状态" Description="登录后可识别主播身份/规避风控；匿名也能收弹幕">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ux:StatusBadge x:Name="LoginBadge" />
                        <TextBlock x:Name="LoginStatusText" Text="未登录" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="QrLoginButton" Content="扫码登录" Click="OnQrLogin" />
                        <Button x:Name="LogoutButton" Content="退出登录" IsEnabled="False" Click="OnLogout" />
                    </StackPanel>
                </StackPanel>
            </tk:SettingsCard>

            <!-- 空闲歌单 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="空闲歌单" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="启用空闲歌单" Description="队列空时自动播放背景音乐；新点歌立即打断">
                <ToggleSwitch x:Name="IdleEnabledToggle" OffContent="" OnContent="" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="播放间隔（秒）" Description="每首空闲歌播完后的等待时长">
                <NumberBox x:Name="IdleIntervalBox" Minimum="1" Maximum="3600" Value="30" Width="140"
                           HorizontalAlignment="Right" />
            </tk:SettingsCard>

            <!-- 点歌队列 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="点歌队列" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="队列容量" Description="同时最多保留几首待播放歌曲（含正在播放）">
                <NumberBox x:Name="QueueMaxSizeBox" Minimum="1" Maximum="999" Value="20" Width="140"
                           HorizontalAlignment="Right" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="单用户上限" Description="同一观众最多同时保留的未完成歌曲数">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch x:Name="QueueUserLimitToggle" OffContent="不限制" OnContent="限制" />
                    <NumberBox x:Name="QueueMaxPerUserBox" Minimum="1" Maximum="100" Value="1" Width="140" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="重复点歌去重" Description="同一首歌已在队列时拒绝重复点歌">
                <ToggleSwitch x:Name="QueueDedupeToggle" OffContent="" OnContent="" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="队列展示条数" Description="快照/网页播放列表显示的最大条目数">
                <NumberBox x:Name="QueueDisplayLimitBox" Minimum="1" Maximum="100" Value="5" Width="140"
                           HorizontalAlignment="Right" />
            </tk:SettingsCard>

            <!-- 点歌等级门槛 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE8A9;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="点歌等级门槛" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="抖音粉丝团等级" Description="灯牌等级达到该级（含）才可点歌；等级未识别时拒绝">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch x:Name="DouyinFanLevelToggle" OffContent="不限制" OnContent="限制" />
                    <NumberBox x:Name="DouyinFanLevelBox" Minimum="1" Maximum="99" Value="1" Width="140" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="B站粉丝勋章等级" Description="佩戴粉丝勋章并达到该级（含）才可点歌；等级未识别时拒绝">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch x:Name="BilibiliMedalLevelToggle" OffContent="不限制" OnContent="限制" />
                    <NumberBox x:Name="BilibiliMedalLevelBox" Minimum="1" Maximum="99" Value="1" Width="140" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="主播/管理员绕过" Description="主播、管理员（房管）点歌不受等级门槛限制">
                <ToggleSwitch x:Name="AdminBypassToggle" OffContent="不绕过" OnContent="绕过" />
            </tk:SettingsCard>

            <!-- 日志 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="日志" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="直播事件落盘" Description="弹幕/礼物等事件写入 logs/erbai-live-*.log；日志页打开时回看当天直播事件">
                <ToggleSwitch x:Name="LiveEventLogToggle" OffContent="" OnContent="" />
            </tk:SettingsCard>

            <!-- 备份 / 恢复 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="备份 / 恢复" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <tk:SettingsCard Header="备份" Description="数据库一致性快照 + 配置 → zip">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="创建备份" Click="OnCreateBackup" />
                    <Button Content="打开备份目录" Click="OnOpenBackupFolder" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="从备份恢复" Description="选择备份文件后恢复数据库与配置">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="BackupListCombo" Width="280" PlaceholderText="选择备份文件…" />
                    <Button Content="恢复" Click="OnRestoreBackup" />
                </StackPanel>
            </tk:SettingsCard>
            <TextBlock x:Name="BackupStatus" Text="" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextStyle}" Margin="4,0,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,8">
                <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
