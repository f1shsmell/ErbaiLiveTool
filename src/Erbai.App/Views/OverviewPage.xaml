<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Erbai.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ux="using:Erbai.App.Ux"
    xmlns:views="using:Erbai.App.Views">
    <ScrollViewer>
        <StackPanel Padding="28,24,28,32" Spacing="18" MaxWidth="1280" HorizontalAlignment="Left">
            <ux:PageHeader Icon="Home" Title="直播概览"
                           Subtitle="连接直播间，查看播放进度与实时互动" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="直播连接" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="启动后开始接收弹幕与礼物事件" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource CardDividerStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,20,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B站直播" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                                <ux:StatusBadge x:Name="BiliBadge" Grid.Column="1" />
                                <TextBlock x:Name="BiliDetailText" Grid.Column="2" Text="-" Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RoomIdBox" PlaceholderText="B站房间号（如 5050）" />
                                <Button x:Name="BiliStartButton" Grid.Column="1" Content="启动" MinWidth="68"
                                        Style="{StaticResource AccentButtonStyle}" Click="OnBiliStart" />
                                <Button x:Name="BiliStopButton" Grid.Column="2" Content="停止" MinWidth="68"
                                        IsEnabled="False" Click="OnBiliStop" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="12" Margin="20,0,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="抖音直播" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                                <ux:StatusBadge x:Name="DouyinBadge" Grid.Column="1" />
                                <TextBlock x:Name="DouyinDetailText" Grid.Column="2" Text="-" Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DouyinRoomBox" PlaceholderText="抖音房间号（可选）" />
                                <Button x:Name="DouyinStartButton" Grid.Column="1" Content="启动" MinWidth="68"
                                        Style="{StaticResource AccentButtonStyle}" Click="OnDouyinStart" />
                                <Button x:Name="DouyinStopButton" Grid.Column="2" Content="停止" MinWidth="68"
                                        IsEnabled="False" Click="OnDouyinStop" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="正在播放" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="PlayerText" Grid.Column="1" Text="-" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="CurrentSongText" Text="暂无播放" FontSize="26" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,18,0,0" />
                        <Border Style="{StaticResource CardDividerStyle}" Margin="0,20,0,14" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="待播队列" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueStatsText" Text="-" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListView x:Name="QueueList" SelectionMode="None" Height="172" Margin="0,8,0,0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,3" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:QueueDisplay">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Position}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SongName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Singer}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="QueueEmptyText" Text="队列为空，可手动点歌或等待观众提交。"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="18">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="手动点歌" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="输入歌名与歌手，按回车即可加入队列" Style="{StaticResource CaptionTextStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DanmakuInput" PlaceholderText="歌名 - 歌手" KeyDown="OnDanmakuInputKeyDown" />
                                <Button Grid.Column="1" Content="添加" MinWidth="68" Style="{StaticResource AccentButtonStyle}" Click="OnSendDanmaku" />
                            </Grid>
                            <TextBlock x:Name="LogText" Text="" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="互动排队" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueUpStatsText" Text="-" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListView x:Name="QueueUpList" SelectionMode="None" Height="108" Margin="0,8,0,0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="4,3" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="views:QueueUpDisplay">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind PositionText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TitleText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SubText}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="QueueUpEmptyText" Text="暂无观众排队" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="实时事件" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewCountText" Text="0 条" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <ListView x:Name="PreviewList" Height="180" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,3" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:DanmakuLogLine">
                                    <TextBlock Text="{x:Bind Line}" Foreground="{x:Bind Color}" TextWrapping="Wrap" FontSize="12" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ux:EmptyState x:Name="PreviewEmptyState" Symbol="Comment"
                                       Title="还没有直播事件"
                                       Subtitle="连接直播间后，弹幕、礼物和关注消息会显示在这里" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
