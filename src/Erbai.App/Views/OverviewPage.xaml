<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Erbai.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ux="using:Erbai.App.Ux"
    xmlns:views="using:Erbai.App.Views">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <!-- 标题区 -->
            <StackPanel Spacing="2">
                <TextBlock Text="概览" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="平台连接、当前播放与待处理队列（悬浮窗样式已移至「显示与悬浮窗」页）" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <!-- 平台连接（统一连接状态：#8 未配置/未连接/已连接/异常，文字+圆点+颜色） -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="B站直播" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ux:StatusBadge x:Name="BiliBadge" />
                            <TextBlock x:Name="BiliDetailText" Text="-" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="RoomIdBox" PlaceholderText="B站房间号（如 5050）" HorizontalAlignment="Stretch" MinWidth="120" MaxWidth="280" />
                            <Button x:Name="BiliStartButton" Content="启动" Style="{StaticResource AccentButtonStyle}" Click="OnBiliStart" />
                            <Button x:Name="BiliStopButton" Content="停止" IsEnabled="False" Click="OnBiliStop" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="抖音直播" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ux:StatusBadge x:Name="DouyinBadge" />
                            <TextBlock x:Name="DouyinDetailText" Text="-" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="DouyinRoomBox" PlaceholderText="抖音房间号（可选，白名单）" HorizontalAlignment="Stretch" MinWidth="120" MaxWidth="280" />
                            <Button x:Name="DouyinStartButton" Content="启动" Style="{StaticResource AccentButtonStyle}" Click="OnDouyinStart" />
                            <Button x:Name="DouyinStopButton" Content="停止" IsEnabled="False" Click="OnDouyinStop" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 手动点歌（评审第一轮 #3：提升到首屏，Enter 提交） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="手动点歌" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="直接输入 歌名 - 歌手；弹幕命令：切歌 / 设置管理员@昵称"
                                   Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="DanmakuInput" HorizontalAlignment="Stretch" PlaceholderText="歌名 - 歌手，回车提交（无需输入点歌）" KeyDown="OnDanmakuInputKeyDown" />
                        <Button Content="发送" Click="OnSendDanmaku" />
                        <Button Content="注入测试弹幕" Click="OnInjectTest" />
                    </StackPanel>
                    <TextBlock x:Name="LogText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 中部主区：正在播放/队列 + 互动排队 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 正在播放 + 歌曲队列 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="正在播放" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="PlayerText" Text="-" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="CurrentSongText" Text="暂无" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="歌曲队列" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueStatsText" Text="-" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="完整列表见「点歌队列」页" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListView x:Name="QueueList" SelectionMode="None" MaxHeight="220">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:QueueDisplay">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Position}" FontWeight="SemiBold" MinWidth="20" />
                                        <TextBlock Text="★" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" Visibility="{x:Bind IsCurrent}" />
                                        <TextBlock Text="{x:Bind SongName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Singer}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="QueueEmptyText" Text="暂无待播歌曲——可在上方手动点歌，或等待直播间观众提交。"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 互动排队 -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="互动排队" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueUpStatsText" Text="-" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="活动与请求见「排队队列」页" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListView x:Name="QueueUpList" SelectionMode="None" MaxHeight="240">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:QueueUpDisplay">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind PositionText}" FontWeight="SemiBold" MinWidth="24" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind TitleText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind SubText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="QueueUpEmptyText" Text="暂无排队——观众可发送「排队 内容」加入，主播可发「完成」推进。"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 实时事件流（默认仅显示直播相关事件） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="实时事件" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewCountText" Text="0 条" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="B站 / 抖音 弹幕 · 礼物 · 关注 · 点赞等 · 完整流水见「日志」页" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="PreviewList" Height="220" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:DanmakuLogLine">
                                <TextBlock Text="{x:Bind Line}" Foreground="{x:Bind Color}" TextWrapping="Wrap" FontSize="12" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>