<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Erbai.App.Views.AdminPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ux="using:Erbai.App.Ux"
    xmlns:storage="using:Erbai.Contracts.Storage"
    xmlns:views="using:Erbai.App.Views">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ux:PageHeader Icon="Admin" Title="管理"
                       Subtitle="歌曲黑名单、用户黑名单与管理员；改动立即写盘并热生效（空闲播放源在「歌单」页标记）" />

        <Pivot Grid.Row="1" Style="{StaticResource AppPivotStyle}">
            <!-- 歌曲黑名单 -->
            <PivotItem Header="歌曲黑名单">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="SongBanBox" PlaceholderText="歌名或 *关键词" Width="280" />
                        <Button Content="添加" Click="OnAddSongBan" />
                        <TextBlock x:Name="SongBanStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="规则：精确歌名拦截同名；以 * 开头按子串匹配（如 *歌手名）。主播也可在弹幕发「拉黑歌曲 XX / 取消拉黑歌曲 XX」。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <ListView x:Name="SongBanList" MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" />
                                    <Button Grid.Column="1" Content="删除" Style="{StaticResource InlineActionButtonStyle}" Click="OnRemoveSongBan" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SongBanEmptyText" Text="暂无黑名单规则——添加歌名或 *关键词 后，匹配的点歌会被拦截。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 用户黑名单 -->
            <PivotItem Header="用户黑名单">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="UserBanSearchBox" PlaceholderText="昵称关键词搜索用户" Width="220" KeyDown="OnSearchUsersForBanKeyDown" />
                        <Button Content="搜索" Click="OnSearchUsersForBan" />
                        <TextBlock x:Name="UserBanStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <ListView x:Name="UserBanCandidates" MaxHeight="200" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="storage:User">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Platform}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind RoomId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="UserBanCandidatesEmptyText" Text="无匹配用户——输入昵称关键词后搜索；用户需先在直播间互动过（发过弹幕/礼物）才会入库。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                    <Button Content="拉黑选中用户" Click="OnBanSelectedUser" />
                    <TextBlock Text="已拉黑用户（被拉黑者无法点歌，主播也可发「拉黑@昵称 / 取消拉黑@昵称」）" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ListView x:Name="UserBanList" MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="storage:BannedUser">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Platform}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Reason}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="解除拉黑" Style="{StaticResource InlineActionButtonStyle}" Click="OnUnbanUser" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="UserBanEmptyText" Text="暂无被拉黑用户。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 管理员 -->
            <PivotItem Header="管理员">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="AdminSearchBox" PlaceholderText="昵称关键词（空=全部，管理员置顶）" Width="260" KeyDown="OnSearchAdminsKeyDown" />
                        <Button Content="搜索" Click="OnSearchAdmins" />
                        <TextBlock x:Name="AdminStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="管理员可发切歌/管理命令、绕过点歌限制（设置页可关「管理员绕过」）；主播也可发「设置管理员@昵称 / 取消管理员@昵称」。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <ListView x:Name="AdminList" MaxHeight="440">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:UserDisplay">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Platform}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind RoomId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Role}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="切换管理员" Style="{StaticResource InlineActionButtonStyle}" Click="OnToggleAdmin" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="AdminEmptyText" Text="暂无用户——直播间有互动后这里会出现用户列表，搜索昵称即可授权。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
