<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Erbai.App.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:storage="using:Erbai.Contracts.Storage"
    xmlns:views="using:Erbai.App.Views">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="管理" Style="{StaticResource PageTitleTextStyle}" />

        <Pivot Grid.Row="1">
            <!-- 空闲歌单 -->
            <PivotItem Header="空闲歌单">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="IdleNameBox" PlaceholderText="歌名" Width="220" />
                        <TextBox x:Name="IdleSingerBox" PlaceholderText="歌手（可选）" Width="160" />
                        <Button Content="添加" Click="OnAddIdle" />
                        <TextBlock x:Name="IdleStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="队列空时自动轮播这些歌（设置页可开关与调间隔）；改动立即保存并生效。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <ListView x:Name="IdleList" MaxHeight="380">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="storage:IdleSong">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Singer}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Content="↑" Click="OnMoveIdleUp" />
                                        <Button Content="↓" Click="OnMoveIdleDown" />
                                        <Button Content="删除" Click="OnRemoveIdle" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="IdleEmptyText" Text="空闲歌单为空——添加歌曲后，队列空时会自动轮播。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
            </PivotItem>

            <!-- 歌曲黑名单 -->
            <PivotItem Header="歌曲黑名单">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="SongBanBox" PlaceholderText="歌名或 *关键词" Width="280" />
                        <Button Content="添加" Click="OnAddSongBan" />
                        <TextBlock x:Name="SongBanStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="规则：精确歌名拦截同名；以 * 开头按子串匹配（如 *歌手名）。主播也可在弹幕发「拉黑歌曲 XX / 取消拉黑歌曲 XX」。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <ListView x:Name="SongBanList" MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" />
                                    <Button Grid.Column="1" Content="删除" Click="OnRemoveSongBan" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </PivotItem>

            <!-- 用户黑名单 -->
            <PivotItem Header="用户黑名单">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="UserBanSearchBox" PlaceholderText="昵称关键词搜索用户" Width="220" />
                        <Button Content="搜索" Click="OnSearchUsersForBan" />
                        <TextBlock x:Name="UserBanStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <ListView x:Name="UserBanCandidates" MaxHeight="200" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="storage:User">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Platform}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind RoomId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="拉黑选中用户" Click="OnBanSelectedUser" />
                    <TextBlock Text="已拉黑用户（被拉黑者无法点歌，主播也可发「拉黑@昵称 / 取消拉黑@昵称」）" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ListView x:Name="UserBanList" MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="storage:BannedUser">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Platform}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Reason}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="解除拉黑" Click="OnUnbanUser" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </PivotItem>

            <!-- 管理员 -->
            <PivotItem Header="管理员">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="AdminSearchBox" PlaceholderText="昵称关键词（空=全部，管理员置顶）" Width="260" />
                        <Button Content="搜索" Click="OnSearchAdmins" />
                        <TextBlock x:Name="AdminStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="管理员可发切歌/管理命令、绕过点歌限制（设置页可关「管理员绕过」）；主播也可发「设置管理员@昵称 / 取消管理员@昵称」。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <ListView x:Name="AdminList" MaxHeight="440">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:UserDisplay">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Platform}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind RoomId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Role}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="切换管理员" Click="OnToggleAdmin" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
