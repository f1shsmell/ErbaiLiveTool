<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Erbai.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ux="using:Erbai.App.Ux"
    xmlns:views="using:Erbai.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 全局 UI 资源（主窗口 UI 改进，2026-08-27）===== -->

            <!-- 统一连接状态转换器（评审第一轮 #8；概览/插件/设置页共用） -->
            <views:ConnectionStateToTextConverter x:Key="StateToText" />
            <views:ConnectionStateToBrushConverter x:Key="StateToBrush" />

            <!-- 页面标题：统一 26 SemiBold（替代各页手写 24/28 不一） -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 小节标题：14 SemiBold -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 次级说明文字：12 灰（主题感知，替代各处手写 Foreground="Gray"） -->
            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 统一卡片：背景/描边/圆角/内边距 + 悬停微缩放反馈（CardHoverEffect，参考 PCL） -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="ux:CardHoverEffect.IsEnabled" Value="True" />
            </Style>

            <!-- 卡片内分隔线（标题区与控件区之间） -->
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Margin" Value="0,10,0,12" />
            </Style>

            <!-- 观感增强（2026-09）：统一控件圆角。
                 覆盖 Fluent 默认 ControlCornerRadius=4 → 8：按钮/文本框/输入框/下拉等
                 全部控件与上层卡片（CardBorderStyle 亦为 8）圆角对齐，观感更圆润统一。
                 浅色/深色主题共用同一套圆角，故置入应用级资源（非 ThemeResource）。 -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

            <!-- ===== 观感打磨第二轮（2026-09，product-design 流程）===== -->

            <!-- 状态胶囊徽章容器：半透明色底 + 圆角胶囊（配 Ellipse 圆点使用）。
                 Background 由使用处绑定具体状态画刷（成功绿/异常红/中性/强调）。 -->
            <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 行内小按钮：列表行内/工具栏的次要操作（替代各页手写 FontSize=12 Padding=8,2）。 -->
            <Style x:Key="InlineActionButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 列表表头条：浅色底 + 统一圆角 8（与全局 ControlCornerRadius 对齐）。 -->
            <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <!-- 统计数字对：大数字 + 小标签（页首摘要区）。 -->
            <Style x:Key="StatNumberTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="StatLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 空态主文案：居中标题行。 -->
            <Style x:Key="EmptyTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- ===== 导航选中态视觉（评审第一轮 #1）=====
                 此前默认 PointerOver 背景与 Selected 背景接近，悬停项看起来像
                 另一个"选中项"。覆盖为透明：悬停只保留前景色变化，不出现背景块；
                 当前项保留蓝色竖条 + 稳定浅背景；键盘焦点走默认 FocusVisual 轮廓。 -->
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
