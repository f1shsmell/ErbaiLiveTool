<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Erbai.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Erbai.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#C65B38</Color>
                    <Color x:Key="SystemAccentColorLight1">#D87552</Color>
                    <Color x:Key="SystemAccentColorLight2">#E49A7F</Color>
                    <Color x:Key="SystemAccentColorLight3">#F0C4B3</Color>
                    <Color x:Key="SystemAccentColorDark1">#A94729</Color>
                    <Color x:Key="SystemAccentColorDark2">#8F3B22</Color>
                    <Color x:Key="SystemAccentColorDark3">#74301D</Color>
                    <SolidColorBrush x:Key="BrandChipBackgroundBrush" Color="#F5E8E1" />
                    <SolidColorBrush x:Key="BrandAccentBrush" Color="#A94729" />
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F6F6F4" />
                    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#F0F0ED" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E2DD" />
                    <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#F4F4F1" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#E7E7E2" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#E1E1DC" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E8E8E3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#E18A68</Color>
                    <Color x:Key="SystemAccentColorLight1">#EBA487</Color>
                    <Color x:Key="SystemAccentColorLight2">#F1BEA8</Color>
                    <Color x:Key="SystemAccentColorLight3">#F5D7C9</Color>
                    <Color x:Key="SystemAccentColorDark1">#C96D4B</Color>
                    <Color x:Key="SystemAccentColorDark2">#AC5739</Color>
                    <Color x:Key="SystemAccentColorDark3">#8C432C</Color>
                    <SolidColorBrush x:Key="BrandChipBackgroundBrush" Color="#392820" />
                    <SolidColorBrush x:Key="BrandAccentBrush" Color="#EBA487" />
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#1D1D1B" />
                    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#191917" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#252523" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A36" />
                    <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#2C2C29" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2B2B28" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#32322E" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#30302C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>

            <views:ConnectionStateToTextConverter x:Key="StateToText" />
            <views:ConnectionStateToBrushConverter x:Key="StateToBrush" />

            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Margin" Value="0,14,0,14" />
            </Style>
            <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="InlineActionButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSubtleBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,7" />
            </Style>
            <Style x:Key="StatNumberTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="StatLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="AppPivotStyle" TargetType="Pivot">
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EmptyTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style TargetType="NavigationViewItem">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="NavigationViewItemHeader">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="12,14,0,2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
