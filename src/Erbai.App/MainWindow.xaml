<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Erbai.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="二白直播助手">
    <Grid Background="{ThemeResource AppWindowBackgroundBrush}">
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsSettingsVisible="False"
                        OpenPaneLength="208" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" Margin="0,40,0,0"
                        Background="{ThemeResource AppSidebarBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="直播互动" />
                <NavigationViewItem Content="点歌队列" Tag="queue">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="排队队列" Tag="queueup">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="歌单" Tag="playlists">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Audio" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="播放历史" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="弹幕日志" Tag="danmakulog">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="应用管理" />
                <NavigationViewItem Content="显示与悬浮窗" Tag="display">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="播放器插件" Tag="plugins">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="诊断" Tag="diagnostics">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="管理" Tag="admin">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Admin" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem IsSelected="False" SelectsOnInvoked="False" IsTabStop="False" Tapped="OnFooterVersionTapped">
                    <TextBlock x:Name="VersionText" Text="v0.1.0" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Background="{ThemeResource AppWindowBackgroundBrush}" />
        </NavigationView>

        <Grid x:Name="AppTitleBar" Height="40" VerticalAlignment="Top" Background="Transparent" IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="AppTitleIcon" Width="16" Height="16" />
                <TextBlock Text="二白直播助手" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
