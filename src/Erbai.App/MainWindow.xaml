<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Erbai.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="二白直播助手">

    <!-- 评审第一轮 #1/#2：OpenPaneLength=224 收窄侧栏；IsBackButtonVisible=Collapsed
         去掉无用途的禁用返回箭头（汉堡保留：Left 模式点击即紧凑/展开）。 -->
    <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsSettingsVisible="False"
                    OpenPaneLength="224" IsBackButtonVisible="Collapsed"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="概览" Tag="overview">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="点歌队列" Tag="queue">
                <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="排队队列" Tag="queueup">
                <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="历史" Tag="history">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="日志" Tag="danmakulog">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- 评审第一轮 #3/#10：悬浮窗治理从概览迁出为独立页 -->
            <NavigationViewItem Content="显示与悬浮窗" Tag="display">
                <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="插件" Tag="plugins">
                <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="诊断" Tag="diagnostics">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="管理" Tag="admin">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Admin" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设置" Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <!-- 观感打磨第二轮：导航 Footer 版本号（低频信息收纳，不用占菜单项） -->
        <NavigationView.FooterMenuItems>
            <NavigationViewItem IsSelected="False" SelectsOnInvoked="False" IsTabStop="False" Tapped="OnFooterVersionTapped">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                </NavigationViewItem.Icon>
                <TextBlock x:Name="VersionText" Text="v0.1.0" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>