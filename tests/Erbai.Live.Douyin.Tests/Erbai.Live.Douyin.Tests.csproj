  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Erbai.Live.Douyin\Erbai.Live.Douyin.csproj" />
    <ProjectReference Include="..\..\src\Erbai.Live.Douyin.Grabber\Erbai.Live.Douyin.Grabber.csproj" />
    <!-- 抖音 E2E（弹幕 → 点歌全链路）横跨验证：产品代码不依赖 SongRequest -->
